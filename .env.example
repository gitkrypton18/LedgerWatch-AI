# LedgerWatch AI — Environment Configuration
# Copy this file to .env and fill in your values

# ─── Paths ──────────────────────────────────────────────────────────
MODEL_PATH=saved_models/isolation_forest.joblib
RISK_ENGINE_PATH=saved_models/risk_engine.joblib
DATABASE_URL=sqlite:///ledgerwatch.db
DATA_DIR=data
PROCESSED_DIR=data/processed

# ─── Training Hyperparameters ───────────────────────────────────────
TEST_SIZE=0.2
RANDOM_STATE=42
N_ESTIMATORS=200
MAX_SAMPLES=auto
MAX_FEATURES=1.0
BOOTSTRAP=False
N_JOBS=-1

# ─── API Security ───────────────────────────────────────────────────
API_KEY=demo-key-123

# ─── CORS Origins ───────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,https://ledgerwatch-ai.vercel.app,https://ledger-watch-ai.vercel.app

# ─── OCR Configuration ──────────────────────────────────────────────
# Set to "true" if EasyOCR fails to install (fallback to mock data)
OCR_MOCK_MODE=false
# GPU acceleration (only if CUDA available — Render pe nahi hai)
OCR_GPU=false
# OCR languages (comma-separated, e.g., "en,hi" for English + Hindi)
OCR_LANGUAGES=en
