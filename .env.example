# LedgerWatch AI — Environment Configuration
# Copy this file to .env and fill in your values

# ─── Paths ──────────────────────────────────────────────────────────────
MODEL_PATH=saved_models/isolation_forest_v1.0.0.joblib
RISK_ENGINE_PATH=saved_models/risk_engine_v1.0.0.joblib
DATABASE_URL=sqlite:///ledgerwatch.db
DATA_DIR=data
PROCESSED_DIR=data/processed

# ─── Training Hyperparameters ───────────────────────────────────────────
TEST_SIZE=0.2
RANDOM_STATE=42
N_ESTIMATORS=200
MAX_SAMPLES=auto
MAX_FEATURES=1.0
BOOTSTRAP=False
N_JOBS=-1

# ─── API Security ───────────────────────────────────────────────────────
API_KEY=demo-key-123

# ─── CORS Origins ───────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,https://ledgerwatch-ai.vercel.app
