# === DATA FILES ===
# Block all data folders except sample.csv
data/processed/
data/raw/
data/interim/
data/external/
# Allow sample.csv for Render seeding
!data/sample.csv
# Block all CSV/Parquet/Excel except sample
*.csv
!data/sample.csv
*.parquet
*.xlsx

# === MODELS ===
# Block all model files by default
*.joblib
*.pkl
*.h5
*.onnx
# Allow saved_models folder and its contents
!saved_models/
!saved_models/*.joblib
!saved_models/*.pkl

